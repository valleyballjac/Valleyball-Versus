diff --git a/src/sim/cosmeticsBuilders.js b/src/sim/cosmeticsBuilders.js
new file mode 100644
index 0000000..087adca
--- /dev/null
+++ b/src/sim/cosmeticsBuilders.js
@@ -0,0 +1,816 @@
+import * as THREE from 'three';
+
+/**
+ * THE VALLEYBALL LOCKER: procedural headwear builders.
+ *
+ * Every export is `create<Item>(radius, colors) -> THREE.Group`, where
+ * `radius` is the head sphere radius and `colors` is the object returned by
+ * getAthleteColors() in ragdoll.js ({ primary, bodyGrey, jointGrey, accent }).
+ *
+ * HEAD-LOCAL FRAME (matches the existing athletic cap in ragdoll.js):
+ *   origin = skull centre, +Y = up, -Z = forward (face), +Z = back, +X = right.
+ * Everything is expressed as a multiple of `radius`, so an item fits any head
+ * the rig derives and survives the feminine variant's 0.92 head scale.
+ *
+ * STRICTLY VISUAL. Nothing in this file knows Rapier exists: no colliders, no
+ * bodies, no mass. These groups are mounted under the head's solid mesh group
+ * and ride along with it; they never feed anything back into the simulation.
+ *
+ * DIRECTORY RULE (src/sim/): nothing here names a wall-clock or scheduler API.
+ *
+ * MATERIAL ROLES: every material carries `userData.colorRole` so that
+ * updateAthletePalette() recolors it when the kit or palette changes:
+ *   'primary'  team-colored fabric / metal                 -> colors.primary
+ *   'accent'   trim in the OPPOSITE of the base layer      -> colors.accent
+ *   'bodyGrey' neutral matte body-tone fixtures            -> colors.bodyGrey
+ *   'visor'    glowing elements (emissive 1.5)             -> primary (or accent on a black kit)
+ *   'fixed'    never recolored (greenstone, leather, foam)
+ */
+
+/** Emissive strength for 'visor' role materials, read back by updateAthletePalette. */
+export const VISOR_EMISSIVE_INTENSITY = 1.5;
+
+/** Pounamu / jade greenstone used by the Wayfinder Cord toki. Not team-tinted. */
+export const JADE_HEX = 0x2f8f6a;
+const LEATHER_HEX = 0x5b3a1e;
+const FOAM_HEX = 0x24262b;
+const PEARL_HEX = 0xf3ecdc;
+
+const UP = new THREE.Vector3(0, 1, 0);
+const _dir = new THREE.Vector3();
+const _mid = new THREE.Vector3();
+
+// ---------------------------------------------------------------------------
+// Materials
+// ---------------------------------------------------------------------------
+
+function roleMaterial(role, color, extra) {
+  const mat = new THREE.MeshStandardMaterial({ color, roughness: 0.62, metalness: 0.06, ...extra });
+  mat.userData.colorRole = role;
+  return mat;
+}
+const primaryMaterial = (c, extra = {}) => roleMaterial('primary', c.primary, extra);
+const accentMaterial = (c, extra = {}) => roleMaterial('accent', c.accent, { roughness: 0.55, metalness: 0.1, ...extra });
+const bodyGreyMaterial = (c, extra = {}) => roleMaterial('bodyGrey', c.bodyGrey, { roughness: c.roughness ?? 0.82, metalness: c.metalness ?? 0.04, ...extra });
+const fixedMaterial = (hex, extra = {}) => roleMaterial('fixed', hex, { roughness: 0.5, metalness: 0.08, ...extra });
+
+function visorMaterial(colors, extra = {}) {
+  const mat = new THREE.MeshStandardMaterial({
+    color: colors.primary,
+    emissive: colors.primary,
+    emissiveIntensity: VISOR_EMISSIVE_INTENSITY,
+    roughness: 0.28,
+    metalness: 0.18,
+    ...extra,
+  });
+  mat.userData.colorRole = 'visor';
+  mat.userData.emissiveIntensity = VISOR_EMISSIVE_INTENSITY;
+  return mat;
+}
+
+const METAL = { roughness: 0.28, metalness: 0.7 };
+
+// ---------------------------------------------------------------------------
+// Geometry helpers
+// ---------------------------------------------------------------------------
+
+function mesh(geometry, material, name) {
+  const m = new THREE.Mesh(geometry, material);
+  m.castShadow = true;
+  m.receiveShadow = false;
+  if (name) m.name = name;
+  return m;
+}
+
+/**
+ * A horizontal ring (or ring segment) around the skull, centred on the face.
+ * `arc` is the swept angle; `arc = 2π` is a full headband. `facing` rotates
+ * the segment's centre around +Y: 0 = forward (-Z), π = backward (+Z).
+ * After the lay-flat the mesh's LOCAL Z is world-up: scale `.z` to make a
+ * band taller or flatter.
+ */
+function ring(radius, tube, arc, material, { y = 0, facing = 0, name, tall = 1 } = {}) {
+  const geo = new THREE.TorusGeometry(radius, tube, 10, Math.max(16, Math.round(arc * 14)), arc);
+  const m = mesh(geo, material, name);
+  m.rotation.set(0, (Math.PI - arc) / 2 + facing, 0);
+  m.rotateX(-Math.PI / 2);
+  m.position.y = y;
+  m.scale.z = tall;
+  return m;
+}
+
+/** A straight strut between two head-local points. */
+function strut(from, to, thickness, material, name) {
+  _dir.subVectors(to, from);
+  const length = _dir.length();
+  const geo = new THREE.CylinderGeometry(thickness, thickness, length, 10, 1);
+  const m = mesh(geo, material, name);
+  _mid.addVectors(from, to).multiplyScalar(0.5);
+  m.position.copy(_mid);
+  m.quaternion.setFromUnitVectors(UP, _dir.normalize());
+  return m;
+}
+
+/** Upper skull dome: a sphere cap from the apex down to polar angle `phi`. */
+function dome(radius, phi, material, name) {
+  return mesh(new THREE.SphereGeometry(radius, 36, 18, 0, Math.PI * 2, 0, phi), material, name);
+}
+
+/** A conical skirt: a brim that droops (`drop` > 0) or lifts (`drop` < 0) from `inner` to `outer`. */
+function brim(inner, outer, drop, thickness, material, name) {
+  const h = Math.max(Math.abs(drop), thickness);
+  const geo = new THREE.CylinderGeometry(drop >= 0 ? inner : outer, drop >= 0 ? outer : inner, h, 48, 1, true);
+  const m = mesh(geo, material, name);
+  m.material.side = THREE.DoubleSide;
+  return m;
+}
+
+/**
+ * A curved baseball bill extending forward from the crown rim: pitched down,
+ * curled at the sides. `direction` -1 = forward, +1 = backward.
+ */
+function curvedBill(radius, rimRadius, rimY, length, thickness, material, direction, name) {
+  const uSteps = 20;
+  const tSteps = 8;
+  const thetaMax = Math.PI * 0.40;
+  const pitch = 0.30;
+  const curl = radius * 0.16;
+  const positions = [];
+  const indices = [];
+  const point = (u, t, layer) => {
+    const theta = u * thetaMax;
+    const profile = Math.max(0, Math.cos(u * Math.PI * 0.5));
+    const bx = rimRadius * Math.sin(theta);
+    const bz = direction * rimRadius * Math.cos(theta);
+    const off = layer === 'top' ? thickness * 0.5 : -thickness * 0.5;
+    if (t <= 0) return [bx * 0.94, rimY + off, bz * 0.94];
+    const L = length * Math.pow(profile, 0.6) * t;
+    const x = bx + Math.sin(theta * 0.6) * L * Math.cos(pitch);
+    const z = bz + direction * Math.cos(theta * 0.6) * L * Math.cos(pitch);
+    const y = rimY - L * Math.sin(pitch) - curl * u * u * t + off;
+    return [x, y, z];
+  };
+  for (const layer of ['top', 'bottom']) {
+    for (let j = 0; j <= tSteps; j++) {
+      const t = j === 0 ? -0.1 : j / tSteps;
+      for (let i = 0; i <= uSteps; i++) positions.push(...point((i / uSteps) * 2 - 1, t, layer));
+    }
+  }
+  const row = uSteps + 1;
+  const layerSize = (tSteps + 1) * row;
+  for (let j = 0; j < tSteps; j++) {
+    for (let i = 0; i < uSteps; i++) {
+      const a = j * row + i;
+      indices.push(a, a + row + 1, a + 1, a, a + row, a + row + 1);
+      const b = layerSize + a;
+      indices.push(b, b + 1, b + row + 1, b, b + row + 1, b + row);
+    }
+  }
+  for (let i = 0; i < uSteps; i++) {
+    const t = tSteps * row + i;
+    const b = layerSize + t;
+    indices.push(t, t + 1, b + 1, t, b + 1, b);
+  }
+  const geo = new THREE.BufferGeometry();
+  geo.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
+  geo.setIndex(indices);
+  geo.computeVertexNormals();
+  const m = mesh(geo, material, name);
+  m.material.side = THREE.DoubleSide;
+  return m;
+}
+
+function group(name) {
+  const g = new THREE.Group();
+  g.name = name;
+  return g;
+}
+
+/** Position on the skull surface at yaw `a` (0 = face, +ve toward +X) and height `y`. */
+function onSkull(R, a, y) {
+  return new THREE.Vector3(R * Math.sin(a), y, -R * Math.cos(a));
+}
