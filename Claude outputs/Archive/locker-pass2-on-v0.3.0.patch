+/** A laced rugby scrum cap in the accent colour, horns rising out of the ear pads. */
+export function createScrumCapHorns(radius, colors) {
+  const g = group('headwear-wrestler_scrum');
+  const cap = accentMaterial(colors, { roughness: 0.8 });
+  const lace = primaryMaterial(colors, { roughness: 0.7 });
+  const hornMat = primaryMaterial(colors, { roughness: 0.45 });
+
+  // Padded skull cap down over the ears.
+  // Skull cap to the eye line; the face stays open.
+  const capR = radius * 1.09;
+  g.add(dome(capR, Math.PI * 0.5, cap, 'cap'));
+  // Quilted ridges.
+  for (const phi of [0.2, 0.34, 0.48]) {
+    const y = capR * Math.cos(Math.PI * phi);
+    g.add(ring(capR * Math.sin(Math.PI * phi) * 1.01, radius * 0.025, Math.PI * 2, cap, { y, name: `ridge-${phi}` }));
+  }
+  // Ear pads.
+  for (const side of [-1, 1]) {
+    const tag = side < 0 ? 'l' : 'r';
+    const pad = mesh(new THREE.CylinderGeometry(radius * 0.38, radius * 0.38, radius * 0.16, 24), cap, `earpad-${tag}`);
+    pad.rotation.z = Math.PI / 2;
+    pad.position.set(side * radius * 1.06, -radius * 0.02, 0);
+    g.add(pad);
+    const rim = mesh(new THREE.TorusGeometry(radius * 0.30, radius * 0.04, 8, 24), cap, `earrim-${tag}`);
+    rim.rotation.y = Math.PI / 2;
+    rim.position.set(side * radius * 1.15, -radius * 0.02, 0);
+    g.add(rim);
+    g.add(horn(radius, hornMat, side, radius * 1.2, radius * 0.26, `horn-${tag}`));
+  }
+  // Front lace: three crosses up the forehead opening.
+  for (const y of [0.1, 0.28, 0.46]) {
+    const w = radius * 0.16;
+    const z = -Math.sqrt(Math.max(0, capR * capR - (y * radius) ** 2)) * 1.01;
+    g.add(strut(new THREE.Vector3(-w, radius * (y - 0.06), z), new THREE.Vector3(w, radius * (y + 0.06), z), radius * 0.02, lace, `lace-a-${y}`));
+    g.add(strut(new THREE.Vector3(w, radius * (y - 0.06), z), new THREE.Vector3(-w, radius * (y + 0.06), z), radius * 0.02, lace, `lace-b-${y}`));
+  }
+  // Chin strap: hugs the jaw from ear pad to ear pad under the chin.
+  g.add(ring(radius * 0.74, radius * 0.035, Math.PI * 0.95, cap, { y: -radius * 0.72, facing: 0, name: 'chinstrap', tall: 1.6 }));
+  return g;
+}
