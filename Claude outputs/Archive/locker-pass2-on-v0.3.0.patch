+  for (const side of [-1, 1]) {
+    const tag = side < 0 ? 'l' : 'r';
+    const main = mesh(new THREE.BoxGeometry(radius * 0.035, radius * 0.34, radius * 0.9), wing, `wing-${tag}`);
+    main.position.set(side * radius * 1.02, radius * 0.5, radius * 0.25);
+    main.rotation.set(-0.6, 0, side * 0.1);
+    g.add(main);
+    const feather = mesh(new THREE.BoxGeometry(radius * 0.03, radius * 0.2, radius * 0.6), wing, `feather-${tag}`);
+    feather.position.set(side * radius * 1.0, radius * 0.3, radius * 0.45);
+    feather.rotation.set(-0.45, 0, side * 0.1);
+    g.add(feather);
+  }
+  const stud = mesh(new THREE.SphereGeometry(radius * 0.07, 12, 8), wing, 'stud');
+  stud.position.y = crownR;
+  g.add(stud);
+  return g;
+}
