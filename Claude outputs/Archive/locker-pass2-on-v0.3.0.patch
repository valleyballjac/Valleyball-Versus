+// ---------------------------------------------------------------------------
+// PURPLE: Silk Road Diadem
+// ---------------------------------------------------------------------------
+
+/**
+ * A regal diadem: a tall centre spire flanked by stepped spires, pearls set
+ * between them along a metallic band, and jewel drops at the temples.
+ */
+export function createCoutureDiadem(radius, colors) {
+  const g = group('headwear-couture_wrap');
+  const metal = primaryMaterial(colors, METAL);
+  const filigree = accentMaterial(colors, METAL);
+  const jewel = visorMaterial(colors);
+  const pearl = fixedMaterial(PEARL_HEX, { roughness: 0.3, metalness: 0.1 });
+
+  const yBand = radius * 0.44;
+  const R = radius * 1.05;
+  g.add(ring(R, radius * 0.06, Math.PI * 1.5, metal, { y: yBand, name: 'band', tall: 1.5 }));
+  g.add(ring(R + radius * 0.02, radius * 0.02, Math.PI * 1.5, filigree, { y: yBand + radius * 0.08, name: 'filigree' }));
+
+  const spires = [
+    { a: 0, h: 1.05, r: 0.13 },
+    { a: -0.42, h: 0.72, r: 0.1 },
+    { a: 0.42, h: 0.72, r: 0.1 },
+    { a: -0.84, h: 0.46, r: 0.08 },
+    { a: 0.84, h: 0.46, r: 0.08 },
+  ];
+  for (const s of spires) {
+    const base = onSkull(R, s.a, yBand + radius * 0.06);
+    const spire = mesh(new THREE.ConeGeometry(radius * s.r, radius * s.h, 10), metal, `spire-${s.a}`);
+    spire.position.copy(base);
+    spire.position.y += radius * s.h * 0.5;
+    spire.rotation.set(-0.2 * Math.cos(s.a), 0, -0.2 * Math.sin(s.a));
+    g.add(spire);
+    const gem = mesh(new THREE.SphereGeometry(radius * s.r * 0.9, 14, 10), jewel, `gem-${s.a}`);
+    gem.position.copy(onSkull(R * 1.04, s.a, yBand + radius * 0.02));
+    g.add(gem);
+    const tip = mesh(new THREE.SphereGeometry(radius * s.r * 0.5, 10, 8), jewel, `tip-${s.a}`);
+    tip.position.copy(base);
+    tip.position.y += radius * s.h;
+    g.add(tip);
+  }
+  for (const a of [-0.63, -0.21, 0.21, 0.63]) {
+    const p = mesh(new THREE.SphereGeometry(radius * 0.055, 10, 8), pearl, `pearl-${a}`);
+    p.position.copy(onSkull(R * 1.04, a, yBand + radius * 0.14));
+    g.add(p);
+  }
+  // Jewel drops at the temples.
+  for (const side of [-1, 1]) {
+    const top = onSkull(R, side * 1.25, yBand);
+    const bottom = onSkull(R * 1.03, side * 1.25, yBand - radius * 0.3);
+    g.add(strut(top, bottom, radius * 0.015, filigree, `drop-chain-${side}`));
+    const drop = mesh(new THREE.SphereGeometry(radius * 0.08, 12, 8), jewel, `drop-${side}`);
+    drop.position.copy(bottom);
+    drop.scale.y = 1.5;
+    g.add(drop);
+  }
+  return g;
+}
