+// ---------------------------------------------------------------------------
+// TEAL: Wayfinder Cord
+// ---------------------------------------------------------------------------
+
+/**
+ * A two-tone braided band with a hanging cord and a large pounamu toki (adze
+ * blade) at the right temple, tied off at the back.
+ */
+export function createWayfinderCord(radius, colors) {
+  const g = group('headwear-rigger_band');
+  const cordTeam = primaryMaterial(colors, { roughness: 0.85 });
+  const cordAccent = accentMaterial(colors, { roughness: 0.85 });
+  const leather = fixedMaterial(LEATHER_HEX, { roughness: 0.8 });
+  const jade = fixedMaterial(JADE_HEX, { roughness: 0.3, metalness: 0.15 });
+
+  const R = radius * 1.05;
+  const yBand = radius * 0.30;
+  // Braid: alternating segments, each a short arc, offset up and down.
+  const segments = 14;
+  for (let i = 0; i < segments; i++) {
+    const arc = (Math.PI * 2) / segments;
+    const facing = i * arc;
+    const seg = ring(R, radius * 0.065, arc * 1.08, i % 2 ? cordAccent : cordTeam, { y: yBand + (i % 2 ? radius * 0.03 : -radius * 0.03), facing, name: `braid-${i}` });
