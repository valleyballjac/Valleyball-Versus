+// ---------------------------------------------------------------------------
+// WHITE: Manager Classic Cap
+// ---------------------------------------------------------------------------
+
+/**
+ * A classic six-panel ball cap: high crown with panel seams, curved bill,
+ * squatchee button, sweatband trim and a rear strap.
+ */
+export function createManagerCap(radius, colors) {
+  const g = group('headwear-manager_cap');
+  const fabric = primaryMaterial(colors, { roughness: 0.7 });
+  const trim = accentMaterial(colors);
+
+  const crownR = radius * 1.10;
+  const phiRim = Math.PI * 0.46;
+  const yRim = crownR * Math.cos(phiRim);
+  const rRim = crownR * Math.sin(phiRim);
+
+  const crown = dome(crownR, phiRim, fabric, 'crown');
+  crown.position.y = radius * 0.04;
+  crown.scale.y = 1.12; // the taller crown of a classic cap
+  g.add(crown);
+
+  // Six panel seams: meridians from the button down to the rim.
+  for (let i = 0; i < 6; i++) {
+    const a = (i / 6) * Math.PI * 2;
+    const seam = mesh(new THREE.TorusGeometry(crownR * 1.005, radius * 0.012, 6, 24, phiRim), trim, `seam-${i}`);
+    seam.rotation.set(0, 0, Math.PI / 2); // arc starts at +Y (the button)
+    seam.rotateX(Math.PI / 2 + a);
+    seam.position.y = radius * 0.04;
+    seam.scale.y = 1.12;
+    g.add(seam);
+  }
+
+  g.add(ring(rRim, radius * 0.045, Math.PI * 2, trim, { y: yRim + radius * 0.02, name: 'sweatband' }));
+
+  g.add(curvedBill(radius, rRim, yRim + radius * 0.01, radius * 1.05, radius * 0.045, fabric, -1, 'bill'));
+
+  const button = mesh(new THREE.SphereGeometry(radius * 0.09, 14, 10), trim, 'button');
+  button.position.y = crownR * 1.12 + radius * 0.02;
+  g.add(button);
+
+  const strap = ring(rRim * 0.98, radius * 0.05, Math.PI * 0.45, trim, { y: yRim + radius * 0.06, facing: Math.PI, name: 'strap', tall: 1.4 });
+  g.add(strap);
+  return g;
+}
