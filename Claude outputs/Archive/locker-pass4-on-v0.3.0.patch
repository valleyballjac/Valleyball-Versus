+// ---------------------------------------------------------------------------
+// RED: Gridiron Horns
+// ---------------------------------------------------------------------------
+
+/**
+ * The seventies NFL helmet: contrasting shell with the face cut open from
+ * the brow, a single face bar at mouth level, the team stripe over the top,
+ * ear holes, and small horns off the stripe.
+ */
+export function createCombatHorns(radius, colors) {
+  const g = group('headwear-wrestler_bands');
+  const shell = accentMaterial(colors, { roughness: 0.35, metalness: 0.2 });
+  const stripe = primaryMaterial(colors, { roughness: 0.4, metalness: 0.15 });
+
+  const shellR = radius * 1.12;
+  // Top cap: full circle down to the brow line.
+  const browPhi = Math.PI * 0.36;
+  g.add(dome(shellR, browPhi, shell, 'shell-top'));
+  // Skirt: from the brow down over the ears and nape, open across the face.
+  // Sphere azimuth: phi = 0 is +X... the face (-Z) sits at phi = 1.5π.
+  const faceOpening = Math.PI * 0.62;
+  const skirtGeo = new THREE.SphereGeometry(
+    shellR, 36, 12,
+    Math.PI * 1.5 + faceOpening / 2, Math.PI * 2 - faceOpening,
+    browPhi, Math.PI * 0.62 - browPhi,
+  );
+  const skirt = mesh(skirtGeo, shell, 'shell-skirt');
+  skirt.material.side = THREE.DoubleSide;
+  g.add(skirt);
+
+  // Centre stripe over the top, brow to nape.
+  const s = mesh(new THREE.TorusGeometry(shellR * 1.01, radius * 0.06, 8, 40, Math.PI * 0.98), stripe, 'stripe');
+  s.rotation.set(0, Math.PI / 2, 0);
+  s.rotateZ(Math.PI * 0.01);
+  s.scale.z = 2.0;
+  g.add(s);
+
+  for (const side of [-1, 1]) {
+    const hole = mesh(new THREE.CylinderGeometry(radius * 0.15, radius * 0.15, radius * 0.04, 20), stripe, side < 0 ? 'ear-l' : 'ear-r');
+    hole.rotation.z = Math.PI / 2;
+    hole.position.set(side * shellR * 0.995, -radius * 0.05, 0);
+    g.add(hole);
+  }
+
+  // Single face bar at mouth level, arms up to the skirt edges.
+  const R = shellR * 1.04;
+  const barR = radius * 0.045;
+  g.add(ring(R, barR, Math.PI * 0.6, shell, { y: -radius * 0.36, name: 'facebar' }));
+  for (const side of [-1, 1]) {
+    g.add(strut(onBand(R, side * Math.PI * 0.3, -radius * 0.36), onSkull(shellR, side * faceOpening / 2, -radius * 0.1), barR, shell, `facebar-arm-${side}`));
+  }
+
+  for (const side of [-1, 1]) {
+    const horn = mesh(new THREE.ConeGeometry(radius * 0.13, radius * 0.55, 12), stripe, side < 0 ? 'horn-l' : 'horn-r');
+    horn.position.set(side * radius * 0.5, radius * 1.1, -radius * 0.1);
+    horn.rotation.set(-0.2, 0, side * -0.5);
+    g.add(horn);
+  }
+  g.add(setMark(globeMark(radius * 0.15, colors), shellR, Math.PI * 0.55, radius * 0.4, radius * 0.15));
+  return g;
+}
