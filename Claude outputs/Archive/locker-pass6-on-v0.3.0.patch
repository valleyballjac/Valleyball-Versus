+      placeCamera(_head, hw.showcase.distance, hw.showcase.azimuth, hw.showcase.elevation, _lookAt, PHOTOBOOTH.headgear.fov, aspect);
+    } else {
+      const p = PHOTOBOOTH.portrait;
+      _lookAt.copy(_head); _lookAt.y += p.lookAtRaise;
+      const target = _head.clone(); target.y -= p.dropBelowHead;
+      placeCamera(target, p.distance, p.azimuth, 0, _lookAt, p.fov, aspect);
+    }
+    if (rig.parent !== studio) studio.add(rig);
+    lightFrom(_head, PHOTOBOOTH.keyIntensity, PHOTOBOOTH.rimIntensity);
+    renderer.shadowMap.needsUpdate = true;
+    renderer.render(studio, camera);
+  }
+
+  // ----------------------------------------------------------- controls
+  const MODES = ['portrait', 'headgear', 'idle', 'action'];
+  function cycle(step) {
+    const index = Math.max(0, ROSTER_ORDER.indexOf(currentId));
+    const next = ROSTER_ORDER[(index + step + ROSTER_ORDER.length) % ROSTER_ORDER.length];
+    dress(next);
+    console.log(`[photobooth] previewing ${next}: ${CANONICAL_ROSTER[next].name} (${previewMode})`);
+  }
+  window.addEventListener('keydown', (event) => {
+    if (event.repeat) return;
+    if (event.code === 'ArrowRight') cycle(1);
+    else if (event.code === 'ArrowLeft') cycle(-1);
+    else if (event.code === 'ArrowUp' || event.code === 'ArrowDown') {
+      const i = MODES.indexOf(previewMode);
+      previewMode = MODES[(i + (event.code === 'ArrowDown' ? 1 : MODES.length - 1)) % MODES.length];
+      console.log(`[photobooth] view: ${previewMode}`);
+    } else if (event.code === 'Enter') captureRosterAvatars().catch((e) => console.error(String(e)));
+  });
+
+  // ------------------------------------------------------------- start-up
+  const previewId = params.get('athlete');
+  const autoCapture = params.get('auto') !== '0';
+  const settleTicks = Number(params.get('settleTick')) > 0 ? Number(params.get('settleTick')) : PHOTOBOOTH.settleTicks;
+  if (MODES.includes(params.get('view'))) previewMode = params.get('view');
+
+  dress(previewId && CANONICAL_ROSTER[previewId] ? previewId : ROSTER_ORDER[0]);
+
+  if (autoCapture) {
+    loop.onTick((tick) => {
+      if (tick === settleTicks) captureRosterAvatars().catch((e) => console.error(String(e)));
+      return undefined;
+    });
+  }
+
+  console.log(
+    `[photobooth] studio ready; previewing "${currentId}" (${previewMode}); ` +
+      (autoCapture ? `auto-capture at tick ${settleTicks}. ` : 'auto-capture off. ') +
+      'Left/Right cycle the roster, Up/Down cycle the view, Enter shoots everything (window.captureRosterAvatars()).',
+  );
+
+  return {
+    studio, camera, renderPreview, captureRosterAvatars, dress, poseFromClip,
+    get currentId() { return currentId; },
+    get done() { return captureDone; },
+    set view(mode) { if (MODES.includes(mode)) previewMode = mode; },
+    get view() { return previewMode; },
+  };
+}
