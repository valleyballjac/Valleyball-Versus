+  joint.position.copy(b);
+  g.add(joint);
+  const windscreen = mesh(new THREE.SphereGeometry(radius * 0.17, 14, 10), foam, 'windscreen');
+  windscreen.position.copy(c);
+  g.add(windscreen);
