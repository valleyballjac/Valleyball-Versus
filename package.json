{
  "name": "valleyball",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Valleyball — Physics volleyball simulation featuring deterministic ragdoll physics and AI opponents.",
  "main": "electron/main.cjs",
  "desktopName": "valleyball-versus.desktop",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "package:itch": "node scripts/package_itch.mjs",
    "determinism": "node scripts/determinism.mjs",
    "test": "node --test \"test/*.test.mjs\" && node scripts/test_boundary_drops.mjs && node scripts/test_athlete_corner_traversal.mjs",
    "test:roll": "node scripts/test_ball_roll.mjs",
    "test:drops": "node scripts/test_boundary_drops.mjs",
    "test:traversal": "node scripts/test_athlete_corner_traversal.mjs",
    "test:negative": "node scripts/test_corner_cap_negative.mjs",
    "scenario": "node scripts/trace.mjs --name all",
    "eval:match": "node scripts/evalMatch.mjs",
    "fixture": "node scripts/play-fixture.mjs",
    "train:bot": "node scripts/trainBot.mjs",
    "trace": "node scripts/trace.mjs",
    "audit": "node scripts/audit.mjs && node scripts/audit_collision_coverage.mjs",
    "audit:coverage": "node scripts/audit_collision_coverage.mjs",
    "profile": "node scripts/profile.mjs",
    "desktop": "npm run desktop:web && electron .",
    "desktop:dev": "node scripts/desktop_dev.mjs",
    "desktop:web": "vite build --base=./ --outDir dist-desktop",
    "desktop:pack": "npm run desktop:web && electron-builder --win --dir",
    "desktop:dist": "npm run desktop:web && electron-builder --win",
    "desktop:dist:mac": "npm run desktop:web && electron-builder --mac",
    "desktop:dist:linux": "npm run desktop:web && electron-builder --linux",
    "desktop:smoke": "node scripts/desktop_smoke.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "lil-gui": "0.21.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "gh-pages": "^6.3.0",
    "playwright": "1.62.1",
    "vite": "8.2.2"
  },
  "build": {
    "appId": "com.valleyball.versus",
    "productName": "Valleyball Versus",
    "directories": {
      "output": "release/desktop",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist-desktop/**/*",
      "!node_modules/**/*"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Valleyball-Versus-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "Valleyball-Versus-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.sports-games",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Valleyball-Versus-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "Valleyball-Versus-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "executableName": "valleyball-versus",
      "artifactName": "Valleyball-Versus-${version}-linux-${arch}.${ext}",
      "syncDesktopName": true
    }
  }
}
