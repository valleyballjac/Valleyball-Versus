+  rimIntensity: 3.8,
+  rimOffset: { right: -0.75, up: 0.65, toward: -1.05 },
+  fillHex: 0x5b6b85,
+  fillIntensity: 0.35,
+  // In the arena the stadium lights already carry the scene; the studio rig
