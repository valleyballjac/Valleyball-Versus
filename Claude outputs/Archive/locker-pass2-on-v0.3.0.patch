+/** The original: angled horns rising from flattened temple pads and a brow band. */
+export function createCombatHorns(radius, colors) {
+  const g = group('headwear-wrestler_bands');
+  const hornMat = primaryMaterial(colors, { roughness: 0.45 });
+  const pad = accentMaterial(colors);
+
+  for (const side of [-1, 1]) {
+    const tag = side < 0 ? 'l' : 'r';
+    const temple = mesh(new THREE.SphereGeometry(radius * 0.40, 18, 14), pad, `pad-${tag}`);
+    temple.position.set(side * radius * 0.90, radius * 0.30, -radius * 0.10);
+    temple.scale.set(0.38, 1, 1);
+    g.add(temple);
+    g.add(horn(radius, hornMat, side, radius * 1.05, radius * 0.24, `horn-${tag}`));
+  }
+  g.add(ring(radius * 1.04, radius * 0.06, Math.PI * 1.35, pad, { y: radius * 0.30, facing: Math.PI, name: 'band' }));
+  return g;
+}
