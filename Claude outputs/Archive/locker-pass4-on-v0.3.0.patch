diff --git a/src/sim/cosmeticsBuilders.js b/src/sim/cosmeticsBuilders.js
new file mode 100644
index 0000000..de1fd76
--- /dev/null
+++ b/src/sim/cosmeticsBuilders.js
@@ -0,0 +1,685 @@
+import * as THREE from 'three';
+
+/**
+ * THE VALLEYBALL LOCKER: procedural headwear builders.
+ *
+ * Every export is `create<Item>(radius, colors) -> THREE.Group`, where
+ * `radius` is the head sphere radius and `colors` is the object returned by
+ * getAthleteColors() in ragdoll.js ({ primary, bodyGrey, jointGrey, accent }).
+ *
+ * HEAD-LOCAL FRAME (matches the existing athletic cap in ragdoll.js):
+ *   origin = skull centre, +Y = up, -Z = forward (face), +Z = back, +X = right.
+ * Everything is expressed as a multiple of `radius`, so an item fits any head
+ * the rig derives and survives the feminine variant's 0.92 head scale.
+ *
+ * STRICTLY VISUAL. Nothing in this file knows Rapier exists: no colliders, no
+ * bodies, no mass. These groups are mounted under the head's solid mesh group
+ * and ride along with it; they never feed anything back into the simulation.
+ *
+ * DIRECTORY RULE (src/sim/): nothing here names a wall-clock or scheduler API.
+ *
+ * MATERIAL ROLES: every material carries `userData.colorRole` so that
+ * updateAthletePalette() recolors it when the kit or palette changes:
+ *   'primary'  team-colored fabric / metal                 -> colors.primary
+ *   'accent'   contrasting trim and the globe mark's facets -> colors.accent
+ *   'bodyGrey' neutral matte body-tone fixtures            -> colors.bodyGrey
+ *   'visor'    glowing elements (emissive 1.5)             -> primary (cool white on a black kit)
+ *   'fixed'    never recolored (foam, jade, the globe's rainbow seams)
+ */
+
+/** Emissive strength for 'visor' role materials, read back by updateAthletePalette. */
+export const VISOR_EMISSIVE_INTENSITY = 1.5;
+
+/** Pounamu / jade greenstone for the Wayfinder toki. Not team-tinted. */
+export const JADE_HEX = 0x2f8f6a;
+const FOAM_HEX = 0x24262b;
+
+/** The globe logo's seam colours, in the order they wrap the ball. */
+const SEAM_HEXES = [0xff3b6b, 0xffd60a, 0x22d3ee, 0x8b5cf6, 0x34d399];
+
+const UP = new THREE.Vector3(0, 1, 0);
+const _dir = new THREE.Vector3();
+const _mid = new THREE.Vector3();
+
+// ---------------------------------------------------------------------------
+// Materials
+// ---------------------------------------------------------------------------
+
+function roleMaterial(role, color, extra) {
+  const mat = new THREE.MeshStandardMaterial({ color, roughness: 0.62, metalness: 0.06, ...extra });
+  mat.userData.colorRole = role;
+  return mat;
+}
+const primaryMaterial = (c, extra = {}) => roleMaterial('primary', c.primary, extra);
+const accentMaterial = (c, extra = {}) => roleMaterial('accent', c.accent, { roughness: 0.55, metalness: 0.1, ...extra });
+const fixedMaterial = (hex, extra = {}) => roleMaterial('fixed', hex, { roughness: 0.5, metalness: 0.08, ...extra });
+
+function visorMaterial(colors, extra = {}) {
+  const mat = new THREE.MeshStandardMaterial({
+    color: colors.primary,
+    emissive: colors.primary,
+    emissiveIntensity: VISOR_EMISSIVE_INTENSITY,
+    roughness: 0.28,
+    metalness: 0.18,
+    ...extra,
+  });
+  mat.userData.colorRole = 'visor';
+  mat.userData.emissiveIntensity = VISOR_EMISSIVE_INTENSITY;
+  return mat;
+}
+
+const METAL = { roughness: 0.3, metalness: 0.65 };
+
+// ---------------------------------------------------------------------------
+// Geometry helpers
+// ---------------------------------------------------------------------------
+
+function mesh(geometry, material, name) {
+  const m = new THREE.Mesh(geometry, material);
+  m.castShadow = true;
+  m.receiveShadow = false;
+  if (name) m.name = name;
+  return m;
+}
+
+/**
+ * A horizontal ring (or ring segment) around the skull, centred on the face.
+ * `arc` is the swept angle; `arc = 2π` is a full headband. `facing` rotates
+ * the segment's centre around +Y: 0 = forward (-Z), π = backward (+Z).
+ * `tall` stretches the tube vertically.
+ */
+function ring(radius, tube, arc, material, { y = 0, facing = 0, name, tall = 1 } = {}) {
+  const geo = new THREE.TorusGeometry(radius, tube, 12, Math.max(16, Math.round(arc * 16)), arc);
+  const m = mesh(geo, material, name);
+  m.rotation.set(0, (Math.PI - arc) / 2 + facing, 0);
+  m.rotateX(-Math.PI / 2);
+  m.position.y = y;
+  m.scale.z = tall;
+  return m;
+}
+
+/** A flat band: an open cylinder segment around the skull, centred on the face (+ `facing`). */
+function band(radius, height, arc, material, { y = 0, facing = 0, name } = {}) {
+  const geo = new THREE.CylinderGeometry(radius, radius, height, Math.max(24, Math.round(arc * 20)), 1, true, 0, arc);
+  const m = mesh(geo, material, name);
+  m.material.side = THREE.DoubleSide;
+  m.rotation.y = Math.PI - arc / 2 + facing;
+  m.position.y = y;
+  return m;
+}
+
+/** A straight strut between two head-local points. */
+function strut(from, to, thickness, material, name) {
+  _dir.subVectors(to, from);
+  const length = _dir.length();
+  const geo = new THREE.CylinderGeometry(thickness, thickness, length, 10, 1);
+  const m = mesh(geo, material, name);
+  _mid.addVectors(from, to).multiplyScalar(0.5);
+  m.position.copy(_mid);
+  m.quaternion.setFromUnitVectors(UP, _dir.normalize());
+  return m;
+}
+
+/** Upper skull dome: a sphere cap from the apex down to polar angle `phi`. */
+function dome(radius, phi, material, name) {
+  return mesh(new THREE.SphereGeometry(radius, 36, 18, 0, Math.PI * 2, 0, phi), material, name);
+}
+
+/** A conical brim from `inner` to `outer`, dropping (`drop` > 0) or lifting toward the edge. */
+function brim(inner, outer, drop, material, name) {
+  const h = Math.max(Math.abs(drop), 0.001);
+  const geo = new THREE.CylinderGeometry(drop >= 0 ? inner : outer, drop >= 0 ? outer : inner, h, 48, 1, true);
+  const m = mesh(geo, material, name);
+  m.material.side = THREE.DoubleSide;
+  return m;
+}
+
+/**
+ * The classic curved baseball bill from ragdoll.js's athletic cap: fused to
+ * the crown rim, pitched by `pitch` (positive = down), curled at the sides.
+ * `direction` -1 = forward, +1 = backward.
+ */
+function curvedBill(radius, rimRadius, rimY, length, thickness, material, direction, name, pitch = 0.26) {
+  const uSteps = 22;
+  const tSteps = 10;
+  const thetaMax = Math.PI * 0.38;
+  const curl = radius * 0.10;
+  const positions = [];
+  const indices = [];
+  const point = (u, t, layer) => {
+    const theta = u * thetaMax;
+    const profile = Math.max(0, Math.cos(u * Math.PI * 0.5));
+    const bx = rimRadius * Math.sin(theta);
+    const bz = direction * rimRadius * Math.cos(theta);
+    const off = layer === 'top' ? thickness * 0.5 : -thickness * 0.5;
+    if (t <= 0) return [bx * 0.96, rimY + off, bz * 0.96];
+    const L = length * Math.pow(profile, 0.72) * t;
+    const x = bx + Math.sin(theta * 0.7) * L * Math.cos(pitch);
+    const z = bz + direction * Math.cos(theta * 0.7) * L * Math.cos(pitch);
+    const y = rimY - L * Math.sin(pitch) - curl * u * u * t + off;
+    return [x, y, z];
+  };
+  for (const layer of ['top', 'bottom']) {
+    for (let j = 0; j <= tSteps; j++) {
+      const t = j === 0 ? -0.15 : j / tSteps;
+      for (let i = 0; i <= uSteps; i++) positions.push(...point((i / uSteps) * 2 - 1, t, layer));
+    }
+  }
+  const row = uSteps + 1;
+  const layerSize = (tSteps + 1) * row;
+  for (let j = 0; j < tSteps; j++) {
+    for (let i = 0; i < uSteps; i++) {
+      const a = j * row + i;
+      indices.push(a, a + row + 1, a + 1, a, a + row, a + row + 1);
+      const b = layerSize + a;
+      indices.push(b, b + 1, b + row + 1, b, b + row + 1, b + row);
+    }
+  }
+  for (let i = 0; i < uSteps; i++) {
+    const t = tSteps * row + i;
+    const b = layerSize + t;
+    indices.push(t, t + 1, b + 1, t, b + 1, b);
+  }
+  const geo = new THREE.BufferGeometry();
+  geo.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
+  geo.setIndex(indices);
+  geo.computeVertexNormals();
+  const m = mesh(geo, material, name);
+  m.material.side = THREE.DoubleSide;
+  return m;
+}
+
+function group(name) {
+  const g = new THREE.Group();
+  g.name = name;
+  return g;
+}
+
+/** Position on a sphere of radius R at yaw `a` (0 = face, +ve toward +X) and height `y`. */
+function onSkull(R, a, y) {
+  const r = Math.sqrt(Math.max(0, R * R - y * y));
+  return new THREE.Vector3(r * Math.sin(a), y, -r * Math.cos(a));
+}
+
+/** Position on a vertical cylinder of radius R (a band) at yaw `a`, height `y`. */
+function onBand(R, a, y) {
+  return new THREE.Vector3(R * Math.sin(a), y, -R * Math.cos(a));
+}
+
+/**
+ * A seam on a sphere of radius r: a circle in the plane spanned by +Z and
+ * `tilt`, pushed `offset` (fraction of r) along that plane's normal so the
+ * seams wander across the ball instead of all meeting at one point.
+ */
+class SeamArc extends THREE.Curve {
+  constructor(r, tilt, a0, a1, offset = 0) {
+    super();
+    this.u = new THREE.Vector3(0, 0, 1);
+    this.v = new THREE.Vector3(Math.cos(tilt), Math.sin(tilt), 0);
+    this.n = new THREE.Vector3().crossVectors(this.u, this.v).normalize();
+    this.d = offset * r;
+    this.rr = Math.sqrt(Math.max(0, r * r - this.d * this.d));
+    this.a0 = a0;
+    this.a1 = a1;
+  }
+  getPoint(t, target = new THREE.Vector3()) {
+    const a = this.a0 + (this.a1 - this.a0) * t;
+    return target.copy(this.n).multiplyScalar(this.d)
+      .addScaledVector(this.u, Math.cos(a) * this.rr)
+      .addScaledVector(this.v, Math.sin(a) * this.rr);
+  }
+}
+
+/**
+ * THE GLOBE MARK: the Valleyball earth as a team badge. A faceted low-poly
+ * ball in the contrasting colour with glowing rainbow seams wandering across
+ * the face that shows. Built facing +Z; `setMark` sinks it into a surface.
+ */
+function globeMark(size, colors, name = 'globe-mark') {
+  const g = group(name);
+  const facets = accentMaterial(colors, { flatShading: true, roughness: 0.6, metalness: 0.08 });
+  g.add(mesh(new THREE.IcosahedronGeometry(size, 1), facets, 'globe'));
+  const seams = [
+    { hex: SEAM_HEXES[0], tilt: 0.35, a0: -1.0, a1: 0.5, offset: 0.45 },
+    { hex: SEAM_HEXES[1], tilt: 1.3, a0: -0.5, a1: 0.9, offset: -0.38 },
+    { hex: SEAM_HEXES[2], tilt: 2.2, a0: -1.1, a1: 0.2, offset: 0.1 },
+    { hex: SEAM_HEXES[3], tilt: -0.6, a0: 0.2, a1: 1.2, offset: -0.55 },
+    { hex: SEAM_HEXES[4], tilt: -1.8, a0: -1.2, a1: -0.1, offset: 0.62 },
+  ];
+  for (const s of seams) {
+    const mat = fixedMaterial(s.hex, { emissive: s.hex, emissiveIntensity: 1.2, roughness: 0.3 });
+    const tube = new THREE.TubeGeometry(new SeamArc(size * 1.02, s.tilt, s.a0, s.a1, s.offset), 24, size * 0.065, 6, false);
+    g.add(mesh(tube, mat, 'seam'));
+  }
+  return g;
+}
+
+/** Sinks a +Z-facing mark into a sphere surface (radius R) at yaw `a`, height `y`. */
+function setMark(mark, R, a, y, size) {
+  const p = onSkull(R, a, y);
+  const normal = p.clone().normalize();
+  mark.position.copy(p).addScaledVector(normal, -size * 0.3);
+  mark.up.set(0, 1, 0);
+  mark.lookAt(_mid.copy(mark.position).add(normal));
+  return mark;
+}
+
+/** Sinks a +Z-facing mark into a vertical band (radius R) at yaw `a`, height `y`. */
+function setMarkOnBand(mark, R, a, y, size) {
+  const p = onBand(R, a, y);
+  const normal = new THREE.Vector3(p.x, 0, p.z).normalize();
+  mark.position.copy(p).addScaledVector(normal, -size * 0.3);
+  mark.up.set(0, 1, 0);
+  mark.lookAt(_mid.copy(mark.position).add(normal));
+  return mark;
+}
