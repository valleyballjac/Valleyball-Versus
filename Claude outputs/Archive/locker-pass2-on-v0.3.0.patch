+
+/**
+ * A proper protective helmet: shell down over the ears, short peak, ear
+ * guards, and a full face grille in the accent colour.
+ */
+export function createWicketGrill(radius, colors) {
+  const g = group('headwear-wicket_grill');
+  const shell = primaryMaterial(colors, { roughness: 0.4, metalness: 0.15 });
+  const bars = accentMaterial(colors, { roughness: 0.45, metalness: 0.5 });
+
+  const shellR = radius * 1.12;
+  const phiShell = Math.PI * 0.58;
+  g.add(dome(shellR, phiShell, shell, 'shell'));
+
+  // Short peak over the brow.
+  const yRim = shellR * Math.cos(phiShell);
+  const rRim = shellR * Math.sin(phiShell);
+  g.add(curvedBill(radius, rRim, yRim + radius * 0.14, radius * 0.5, radius * 0.05, shell, -1, 'peak'));
+
+  // Ear guards.
+  for (const side of [-1, 1]) {
+    const guard = mesh(new THREE.CylinderGeometry(radius * 0.36, radius * 0.36, radius * 0.14, 24), shell, side < 0 ? 'ear-l' : 'ear-r');
+    guard.rotation.z = Math.PI / 2;
+    guard.position.set(side * radius * 1.06, -radius * 0.05, 0);
+    g.add(guard);
+  }
+
+  // Face grille: hoops and uprights from the eye line to below the chin.
+  const R = radius * 1.18;
+  const bar = radius * 0.034;
+  for (const y of [0.12, -0.08, -0.28, -0.48]) {
+    g.add(ring(R, bar, Math.PI * 0.9, bars, { y: radius * y, name: `hoop-${y}` }));
+  }
+  for (const a of [-0.8, -0.27, 0.27, 0.8]) {
+    g.add(strut(onSkull(R, a, radius * 0.2), onSkull(R, a, -radius * 0.6), bar, bars, `upright-${a}`));
+  }
+  // Grille anchors up to the ear guards.
+  for (const side of [-1, 1]) {
+    g.add(strut(onSkull(R, side * 0.8, radius * 0.2), new THREE.Vector3(side * radius * 1.05, radius * 0.05, -radius * 0.2), bar, bars, `anchor-${side}`));
+  }
+  return g;
+}
