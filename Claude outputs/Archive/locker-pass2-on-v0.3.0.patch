+  }
+  // Second, thinner leather cord below.
+  g.add(ring(R, radius * 0.03, Math.PI * 2, leather, { y: yBand - radius * 0.13, name: 'cord' }));
+
+  // Knot at the back-right with cord tails.
+  const k = onSkull(R * 1.02, Math.PI * 0.75, yBand - radius * 0.05);
+  const knot = mesh(new THREE.SphereGeometry(radius * 0.11, 14, 10), cordAccent, 'knot');
+  knot.position.copy(k);
+  g.add(knot);
+  g.add(strut(k, new THREE.Vector3(k.x + radius * 0.1, k.y - radius * 0.5, k.z + radius * 0.14), radius * 0.028, cordTeam, 'tail-a'));
+  g.add(strut(k, new THREE.Vector3(k.x - radius * 0.05, k.y - radius * 0.42, k.z + radius * 0.22), radius * 0.028, cordAccent, 'tail-b'));
+
+  // The toki: a big jade adze blade hanging from the right temple.
+  const anchor = onSkull(R, 0.78, yBand - radius * 0.1);
+  const blade = new THREE.Vector3(anchor.x + radius * 0.06, anchor.y - radius * 0.46, anchor.z - radius * 0.02);
+  g.add(strut(anchor, blade, radius * 0.02, leather, 'toki-cord'));
+  const toki = mesh(new THREE.BoxGeometry(radius * 0.16, radius * 0.4, radius * 0.06), jade, 'toki');
+  toki.position.copy(blade);
+  toki.position.y -= radius * 0.14;
+  toki.rotation.set(0, 0.78, 0.08);
+  g.add(toki);
+  const edge = mesh(new THREE.ConeGeometry(radius * 0.09, radius * 0.16, 4), jade, 'toki-edge');
+  edge.position.copy(toki.position);
+  edge.position.y -= radius * 0.27;
+  edge.rotation.set(Math.PI, 0.78 + Math.PI / 4, 0);
+  g.add(edge);
+  return g;
+}
+
+// ---------------------------------------------------------------------------
+// YELLOW: Stadium Headset
+// ---------------------------------------------------------------------------
+
+/**
+ * Big broadcast cans: oversized cups on both ears, a thick padded headband,
+ * a chunky boom with a foam windscreen, and an on-air lamp.
+ */
+export function createBroadcasterHeadset(radius, colors) {
+  const g = group('headwear-broadcaster_mic');
+  const shell = primaryMaterial(colors, { roughness: 0.45, metalness: 0.2 });
+  const trim = accentMaterial(colors, { roughness: 0.5, metalness: 0.3 });
+  const foam = fixedMaterial(FOAM_HEX, { roughness: 0.95 });
+  const lamp = visorMaterial(colors);
+
+  const yEar = -radius * 0.02;
+  const xEar = radius * 1.0;
+  for (const side of [-1, 1]) {
+    const tag = side < 0 ? 'l' : 'r';
+    const cup = mesh(new THREE.CylinderGeometry(radius * 0.5, radius * 0.5, radius * 0.26, 28), shell, `cup-${tag}`);
+    cup.rotation.z = Math.PI / 2;
+    cup.position.set(side * (xEar + radius * 0.14), yEar, 0);
+    g.add(cup);
+    const pad = mesh(new THREE.TorusGeometry(radius * 0.38, radius * 0.1, 10, 28), trim, `pad-${tag}`);
+    pad.rotation.y = Math.PI / 2;
+    pad.position.set(side * (xEar + radius * 0.02), yEar, 0);
+    g.add(pad);
+    const yoke = mesh(new THREE.BoxGeometry(radius * 0.1, radius * 0.5, radius * 0.16), trim, `yoke-${tag}`);
+    yoke.position.set(side * (xEar + radius * 0.2), yEar + radius * 0.32, 0);
+    g.add(yoke);
+  }
+
+  // Thick padded headband plus an outer rail.
+  const band = mesh(new THREE.TorusGeometry(radius * 1.16, radius * 0.09, 10, 36, Math.PI), trim, 'headband');
+  band.position.y = yEar + radius * 0.06;
+  band.scale.z = 1.6;
+  g.add(band);
+  const rail = mesh(new THREE.TorusGeometry(radius * 1.28, radius * 0.035, 8, 36, Math.PI), shell, 'rail');
+  rail.position.y = yEar + radius * 0.06;
+  g.add(rail);
+
+  // Boom mic: thick articulated arm from the left cup to a foam windscreen.
+  const a = new THREE.Vector3(-xEar - radius * 0.28, yEar - radius * 0.3, -radius * 0.1);
+  const b = new THREE.Vector3(-radius * 0.85, -radius * 0.55, -radius * 0.75);
+  const c = new THREE.Vector3(-radius * 0.3, -radius * 0.62, -radius * 1.1);
+  g.add(strut(a, b, radius * 0.045, trim, 'boom-a'));
+  g.add(strut(b, c, radius * 0.045, trim, 'boom-b'));
