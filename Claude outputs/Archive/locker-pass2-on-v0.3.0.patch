+ * transforms and the renderer's output size, and puts the renderer back.
+ *
+ * Exposed on the page as `window.captureRosterAvatars()`, and auto-fired once
+ * the sim has settled unless `?auto=0`. Every capture is POSTed to
+ * `/api/capture` (vite-plugin-capture.js) into captures/avatars/.
+ */
+
+export const PHOTOBOOTH = Object.freeze({
+  endpoint: '/api/capture',
