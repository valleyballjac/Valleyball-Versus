+  // ---------------------------------------------------------------- poses
+  /**
+   * Poses the ragdoll VISUALS from a clip frame on the kinematic ghost.
+   * Returns a restore function. Nothing physical is touched.
+   */
+  function poseFromClip(clipName, time) {
+    const at = athlete.animTarget;
+    const rig = athlete.ragdoll?.rig;
+    if (!at?.root || !rig) return () => {};
+    const clip = at.clips.find((c) => c.name === clipName);
+    if (!clip) {
+      console.warn(`[photobooth] clip "${clipName}" not found; keeping the live pose`);
+      return () => {};
+    }
+
+    const saved = [];
+    at.root.traverse((o) => {
+      if (o.isBone) saved.push([o, o.position.clone(), o.quaternion.clone(), o.scale.clone()]);
+    });
+
+    const mixer = new THREE.AnimationMixer(at.root);
+    const action = mixer.clipAction(clip);
+    action.play();
+    mixer.setTime(Math.max(0, Math.min(clip.duration - 1e-3, time)));
+
+    // L5 root strip, as animtarget applies it: hips pinned horizontally to bind.
+    if (at.hips) {
+      at.hips.position[at.hipsAxisA] = at.hipsBindA;
+      at.hips.position[at.hipsAxisB] = at.hipsBindB;
+    }
+    at.root.updateMatrixWorld(true);
+
+    for (const [k, item] of rig) {
+      const bone = at.bones.get(k);
+      if (!bone || !item.mesh) continue;
+      _bindInv.copy(item.bindBoneWorld).invert();
+      _m.multiplyMatrices(bone.matrixWorld, _bindInv).multiply(item.bindBodyWorld);
+      _m.decompose(item.mesh.position, item.mesh.quaternion, _scaleOut);
+    }
+
+    return () => {
+      for (const [o, p, q, s] of saved) { o.position.copy(p); o.quaternion.copy(q); o.scale.copy(s); }
+      mixer.stopAllAction();
+      mixer.uncacheRoot(at.root);
+      at.root.updateMatrixWorld(true);
+    };
+  }
+
+  // ------------------------------------------------------------- dressing
+  function dress(id, headwearOverride = null, kitOverride = null) {
+    const entry = CANONICAL_ROSTER[id];
+    if (!entry) throw new Error(`[photobooth] unknown roster id "${id}"`);
+    const palette = PALETTES[entry.palette];
+    const headwear = headwearOverride || (HEADWEAR_CATALOG[entry.headwear] ? entry.headwear : 'none');
+    athlete.setTeamAndVariant(kitOverride || entry.kit, entry.variant, { primaryColor: palette.hex, headwear });
+    currentId = id;
+    return entry;
+  }
+
+  // ------------------------------------------------------------ rendering
+  function borrow(target) {
+    const group = athlete?.ragdoll?.group;
+    if (!group) return null;
+    if (group.parent !== target) target.add(group);
+    group.visible = true;
+    return group;
+  }
+
+  function withOutputSize(width, height, fn) {
+    const previousPixelRatio = renderer.getPixelRatio();
+    renderer.setPixelRatio(1);
+    renderer.setSize(width, height, false);
+    renderer.setScissorTest(false);
+    renderer.setViewport(0, 0, width, height);
+    try {
+      return fn();
+    } finally {
+      renderer.setPixelRatio(previousPixelRatio);
+      restoreViewport();
+    }
+  }
+
+  function snap(target) {
+    renderer.shadowMap.needsUpdate = true;
+    renderer.render(target, camera);
+    return renderer.domElement.toDataURL('image/png');
+  }
+
+  /** Portrait or headgear shot in the studio. */
+  function studioShot(kind, aspect, id, view = null) {
+    borrow(studio);
+    athlete.renderPose(1);
+    studio.background = backdropFor(id);
+    const head = headPart();
+    const headR = (head?.radius ?? 0.11) * (head?.solidMesh?.scale.x ?? 1);
+    measure();
+    if (kind === 'portrait') {
+      const p = view || PHOTOBOOTH.portrait;
+      _lookAt.copy(_head);
+      _lookAt.y += p.lookAtRaise;
+      const target = _head.clone();
+      target.y -= p.dropBelowHead;
+      placeCamera(target, p.distance, p.azimuth, 0, _lookAt, p.fov, aspect);
+    } else {
+      const entry = HEADWEAR_CATALOG[athlete.ragdoll.headwear] || HEADWEAR_CATALOG.none;
+      const s = view || entry.showcase;
+      _lookAt.copy(_head);
+      _lookAt.y += PHOTOBOOTH.headgear.lookAtRaise + headR * 0.15;
+      placeCamera(_head, s.distance, s.azimuth, s.elevation, _lookAt, PHOTOBOOTH.headgear.fov, aspect);
+    }
+    if (rig.parent !== studio) studio.add(rig);
+    lightFrom(_head, PHOTOBOOTH.keyIntensity, PHOTOBOOTH.rimIntensity);
+    return snap(studio);
+  }
+
+  /** Full-body shot in the arena, posed from a clip frame. */
+  function arenaShot(clipName, time, view, aspect) {
+    borrow(scene);
+    athlete.renderPose(1);
+    const restore = poseFromClip(clipName, time);
+    try {
+      measure();
+      const target = _feet.clone();
+      target.y += view.lensHeight;
+      _lookAt.copy(_feet);
+      _lookAt.y += view.lookAtHeight;
+      placeCamera(target, view.distance, view.azimuth, 0, _lookAt, view.fov, aspect);
+      if (rig.parent !== scene) scene.add(rig);
+      const anchor = _feet.clone();
+      anchor.y += 1.0;
+      lightFrom(anchor, PHOTOBOOTH.arenaKeyIntensity, PHOTOBOOTH.arenaRimIntensity, 2.2);
+      const data = snap(scene);
+      studio.add(rig);
+      return data;
+    } finally {
+      restore();
+    }
+  }
+
+  /** Floor height under a world XZ, from the arena meshes; null if none. */
+  const raycaster = new THREE.Raycaster();
+  function floorAt(x, z, fallbackY) {
+    const arena = scene.getObjectByName('arena-court') || scene.getObjectByName('arena-bowl') || scene;
+    _rayOrigin.set(x, fallbackY + 4, z);
+    raycaster.set(_rayOrigin, _rayDown);
+    raycaster.far = 12;
+    const hits = raycaster.intersectObject(arena, true);
+    for (const h of hits) {
+      if (h.object.isMesh && h.object.visible) return h.point.y;
+    }
+    return fallbackY;
+  }
+
+  /** The rainbow line-up: clones of the dressed, posed athlete along a line at centre court. */
+  function groupShot(aspect, kit = 'home', g = PHOTOBOOTH.group) {
+    borrow(scene);
+    athlete.renderPose(1);
+    measure();
+    const origin = _feet.clone();
+    const forward = _forward.clone();
+    const right = new THREE.Vector3().crossVectors(forward, _yAxis).normalize();
+
+    const lineup = new THREE.Group();
+    lineup.name = 'photobooth-lineup';
+    const n = RAINBOW_ORDER.length;
+    // Floor heights first, with nothing of ours in the way of the rays.
+    athlete.ragdoll.group.visible = false;
+    const floors = RAINBOW_ORDER.map((_, i) => {
+      const offset = -(i - (n - 1) / 2) * g.spacing;
+      return floorAt(origin.x + right.x * offset, origin.z + right.z * offset, origin.y);
+    });
+    athlete.ragdoll.group.visible = true;
+    RAINBOW_ORDER.forEach((id, i) => {
+      const entry = dress(id, null, kit);
+      athlete.renderPose(1);
+      const restore = poseFromClip(PHOTOBOOTH.idleClip, entry.idleTime);
+      athlete.ragdoll.group.updateMatrixWorld(true);
+      const clone = athlete.ragdoll.group.clone(true);
+      clone.traverse((o) => {
+        if (o.isMesh) {
+          o.material = Array.isArray(o.material) ? o.material.map((m) => m.clone()) : o.material.clone();
+          o.visible = o.visible && !o.name.startsWith('ragdoll-wire');
+        }
+      });
+      restore();
+      const offset = -(i - (n - 1) / 2) * g.spacing;
+      clone.position.set(right.x * offset, floors[i] - origin.y, right.z * offset);
+      lineup.add(clone);
+    });
+    scene.add(lineup);
+    athlete.ragdoll.group.visible = false;
+
+    try {
+      const centre = origin.clone();
+      centre.y += g.lookAtHeight;
+      const target = origin.clone();
+      target.y += g.lensHeight;
+      _forward.copy(forward);
+      placeCamera(target, g.distance, g.azimuth, 0, centre, g.fov, aspect);
+      if (rig.parent !== scene) scene.add(rig);
+      const anchor = origin.clone();
+      anchor.y += 1.0;
+      lightFrom(anchor, PHOTOBOOTH.arenaKeyIntensity * 0.5, PHOTOBOOTH.arenaRimIntensity, 5.0);
+      const data = snap(scene);
+      studio.add(rig);
+      return data;
+    } finally {
+      scene.remove(lineup);
+      lineup.traverse((o) => {
+        if (o.isMesh) { if (Array.isArray(o.material)) o.material.forEach((m) => m.dispose()); else o.material.dispose(); }
+      });
+      athlete.ragdoll.group.visible = true;
+    }
+  }
+
+  // ---------------------------------------------------------------- posts
+  async function post(name, dataUrl, tick) {
+    const response = await fetch(PHOTOBOOTH.endpoint, {
+      method: 'POST',
+      headers: { 'content-type': 'application/json' },
+      body: JSON.stringify({ name, dir: PHOTOBOOTH.outputDir, exact: true, tick, dataUrl }),
+    });
+    const body = await response.json().catch(() => null);
+    if (!response.ok) throw new Error(`[photobooth] ${response.status} ${(body && body.error) || 'capture failed'}`);
+    return body.path;
+  }
+
+  // --------------------------------------------------------------- shoots
+  /**
+   * Shoots the whole roster at the current tick: four shots each, the
+   * headgear variants, and the group photograph. Renders happen inside one
+   * JS turn; uploads follow.
+   */
+  async function captureRosterAvatars() {
+    const tick = loop.tick;
+    const P = PHOTOBOOTH.portraitSize;
+    const B = PHOTOBOOTH.bodySize;
+    const G = PHOTOBOOTH.groupSize;
+    const shots = [];
+    const started = currentId;
+
+    const bodyAspect = B.width / B.height;
+    for (const id of ROSTER_ORDER) {
+      const entry = dress(id);
+      const a2 = entry.action2 || entry.action;
+      shots.push({ name: `${id}_portrait`, data: withOutputSize(P, P, () => studioShot('portrait', 1, id)) });
+      shots.push({ name: `${id}_portrait_b`, data: withOutputSize(P, P, () => studioShot('portrait', 1, id, PHOTOBOOTH.portraitB)) });
+      shots.push({ name: `${id}_headgear`, data: withOutputSize(P, P, () => studioShot('headgear', 1, id)) });
+      shots.push({ name: `${id}_headgear_rear`, data: withOutputSize(P, P, () => studioShot('headgear', 1, id, PHOTOBOOTH.headgearRear)) });
+      shots.push({ name: `${id}_idle`, data: withOutputSize(B.width, B.height, () => arenaShot(PHOTOBOOTH.idleClip, entry.idleTime, PHOTOBOOTH.body, bodyAspect)) });
+      shots.push({ name: `${id}_idle_side`, data: withOutputSize(B.width, B.height, () => arenaShot(PHOTOBOOTH.idleClip, entry.idleTime, PHOTOBOOTH.bodySide, bodyAspect)) });
+      shots.push({ name: `${id}_action`, data: withOutputSize(B.width, B.height, () => arenaShot(entry.action.clip, entry.action.time, PHOTOBOOTH.action, bodyAspect)) });
+      shots.push({ name: `${id}_action_b`, data: withOutputSize(B.width, B.height, () => arenaShot(a2.clip, a2.time, PHOTOBOOTH.actionB, bodyAspect)) });
+    }
+    for (const [id, variants] of Object.entries(HEADWEAR_VARIANTS)) {
+      for (const hw of variants) {
+        dress(id, hw);
+        shots.push({ name: `variant_${id}_${hw}`, data: withOutputSize(P, P, () => studioShot('headgear', 1, id)) });
+      }
+    }
+    const groupAspect = G.width / G.height;
+    shots.push({ name: 'group_rainbow_home', data: withOutputSize(G.width, G.height, () => groupShot(groupAspect, 'home')) });
+    shots.push({ name: 'group_rainbow_away', data: withOutputSize(G.width, G.height, () => groupShot(groupAspect, 'away')) });
+    shots.push({ name: 'group_rainbow_angle', data: withOutputSize(G.width, G.height, () => groupShot(groupAspect, 'home', PHOTOBOOTH.groupAngle)) });
+    dress(started || ROSTER_ORDER[0]);
+
+    const results = [];
+    for (const shot of shots) {
+      const path = await post(shot.name, shot.data, tick);
+      results.push({ name: shot.name, path });
+    }
+    // Spec-compatible aliases: avatars/<id>.png is the portrait.
+    for (const id of ROSTER_ORDER) {
+      const portrait = shots.find((s) => s.name === `${id}_portrait`);
+      if (portrait) results.push({ name: id, path: await post(id, portrait.data, tick) });
+    }
+    console.log(`[photobooth] ${results.length} files captured at tick ${tick}`);
+    captureDone = { tick, results };
+    window.__photoboothDone = captureDone;
+    return results;
+  }
+
+  /** Live preview: the current athlete in the chosen view, filling the canvas. */
+  function renderPreview(width, height) {
+    const aspect = width / height;
+    const id = currentId || ROSTER_ORDER[0];
+    const entry = CANONICAL_ROSTER[id];
+    renderer.setScissorTest(false);
+    renderer.setViewport(0, 0, width, height);
+    if (previewMode === 'idle' || previewMode === 'action') {
+      const clipName = previewMode === 'idle' ? PHOTOBOOTH.idleClip : entry.action.clip;
+      const time = previewMode === 'idle' ? entry.idleTime : entry.action.time;
+      borrow(scene);
+      const restore = poseFromClip(clipName, time);
+      measure();
+      const view = previewMode === 'idle' ? PHOTOBOOTH.body : PHOTOBOOTH.action;
+      const target = _feet.clone(); target.y += view.lensHeight;
+      _lookAt.copy(_feet); _lookAt.y += view.lookAtHeight;
+      placeCamera(target, view.distance, view.azimuth, 0, _lookAt, view.fov, aspect);
+      if (rig.parent !== scene) scene.add(rig);
+      const anchor = _feet.clone(); anchor.y += 1.0;
+      lightFrom(anchor, PHOTOBOOTH.arenaKeyIntensity, PHOTOBOOTH.arenaRimIntensity, 2.2);
+      renderer.shadowMap.needsUpdate = true;
+      renderer.render(scene, camera);
+      restore();
+      return;
+    }
+    borrow(studio);
+    studio.background = backdropFor(id);
+    measure();
+    if (previewMode === 'headgear') {
+      const hw = HEADWEAR_CATALOG[athlete.ragdoll.headwear] || HEADWEAR_CATALOG.none;
+      _lookAt.copy(_head);
+      placeCamera(_head, hw.showcase.distance, hw.showcase.azimuth, hw.showcase.elevation, _lookAt, PHOTOBOOTH.headgear.fov, aspect);
+    } else {
+      const p = PHOTOBOOTH.portrait;
+      _lookAt.copy(_head); _lookAt.y += p.lookAtRaise;
+      const target = _head.clone(); target.y -= p.dropBelowHead;
+      placeCamera(target, p.distance, p.azimuth, 0, _lookAt, p.fov, aspect);
+    }
+    if (rig.parent !== studio) studio.add(rig);
+    lightFrom(_head, PHOTOBOOTH.keyIntensity, PHOTOBOOTH.rimIntensity);
+    renderer.shadowMap.needsUpdate = true;
+    renderer.render(studio, camera);
+  }
+
+  // ----------------------------------------------------------- controls
+  const MODES = ['portrait', 'headgear', 'idle', 'action'];
+  function cycle(step) {
+    const index = Math.max(0, ROSTER_ORDER.indexOf(currentId));
+    const next = ROSTER_ORDER[(index + step + ROSTER_ORDER.length) % ROSTER_ORDER.length];
+    dress(next);
+    console.log(`[photobooth] previewing ${next}: ${CANONICAL_ROSTER[next].name} (${previewMode})`);
+  }
+  window.addEventListener('keydown', (event) => {
+    if (event.repeat) return;
+    if (event.code === 'ArrowRight') cycle(1);
+    else if (event.code === 'ArrowLeft') cycle(-1);
+    else if (event.code === 'ArrowUp' || event.code === 'ArrowDown') {
+      const i = MODES.indexOf(previewMode);
+      previewMode = MODES[(i + (event.code === 'ArrowDown' ? 1 : MODES.length - 1)) % MODES.length];
+      console.log(`[photobooth] view: ${previewMode}`);
+    } else if (event.code === 'Enter') captureRosterAvatars().catch((e) => console.error(String(e)));
+  });
+
+  // ------------------------------------------------------------- start-up
+  const previewId = params.get('athlete');
+  const autoCapture = params.get('auto') !== '0';
+  const settleTicks = Number(params.get('settleTick')) > 0 ? Number(params.get('settleTick')) : PHOTOBOOTH.settleTicks;
+  if (MODES.includes(params.get('view'))) previewMode = params.get('view');
+
+  dress(previewId && CANONICAL_ROSTER[previewId] ? previewId : ROSTER_ORDER[0]);
+
+  if (autoCapture) {
+    loop.onTick((tick) => {
+      if (tick === settleTicks) captureRosterAvatars().catch((e) => console.error(String(e)));
+      return undefined;
+    });
+  }
+
+  console.log(
+    `[photobooth] studio ready; previewing "${currentId}" (${previewMode}); ` +
+      (autoCapture ? `auto-capture at tick ${settleTicks}. ` : 'auto-capture off. ') +
+      'Left/Right cycle the roster, Up/Down cycle the view, Enter shoots everything (window.captureRosterAvatars()).',
+  );
+
+  return {
+    studio, camera, renderPreview, captureRosterAvatars, dress, poseFromClip,
+    get currentId() { return currentId; },
+    get done() { return captureDone; },
+    set view(mode) { if (MODES.includes(mode)) previewMode = mode; },
+    get view() { return previewMode; },
+  };
+}
