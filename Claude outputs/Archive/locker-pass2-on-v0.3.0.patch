+/**
+ * A wide cloth headband with a curved metal forehead plate bearing the
+ * Valleyball "V", tied at the back with long trailing ribbons.
+ */
+export function createOuendanHeadband(radius, colors) {
+  const g = group('headwear-ouendan_knot');
+  const cloth = primaryMaterial(colors, { roughness: 0.8 });
+  const plate = accentMaterial(colors, METAL);
+  const engraving = fixedMaterial(0x6b7280, { roughness: 0.4, metalness: 0.6 });
+
+  const yBand = radius * 0.26;
+  const R = radius * 1.05;
+  g.add(ring(R, radius * 0.08, Math.PI * 2, cloth, { y: yBand, name: 'band', tall: 2.4 }));
+
+  // The plate: a curved rectangle on the forehead.
+  g.add(ring(R + radius * 0.06, radius * 0.11, Math.PI * 0.5, plate, { y: yBand, name: 'plate', tall: 2.0 }));
+  // Engraved V.
+  const pz = -(R + radius * 0.2);
+  g.add(strut(new THREE.Vector3(-radius * 0.11, yBand + radius * 0.12, pz + radius * 0.01), new THREE.Vector3(0, yBand - radius * 0.1, pz - radius * 0.03), radius * 0.018, engraving, 'v-a'));
+  g.add(strut(new THREE.Vector3(radius * 0.11, yBand + radius * 0.12, pz + radius * 0.01), new THREE.Vector3(0, yBand - radius * 0.1, pz - radius * 0.03), radius * 0.018, engraving, 'v-b'));
+  // Rivets at the plate corners.
+  for (const sx of [-1, 1]) for (const sy of [-1, 1]) {
+    const rivet = mesh(new THREE.SphereGeometry(radius * 0.03, 8, 6), engraving, `rivet-${sx}${sy}`);
+    rivet.position.copy(onSkull(R + radius * 0.17, sx * 0.62, yBand + sy * radius * 0.16));
+    g.add(rivet);
+  }
+
+  // Knot and long ribbons.
+  const knot = mesh(new THREE.SphereGeometry(radius * 0.15, 14, 10), cloth, 'knot');
+  knot.position.set(0, yBand, radius * 1.05);
+  knot.scale.set(1.3, 0.8, 0.8);
+  g.add(knot);
+  for (const side of [-1, 1]) {
+    const tag = side < 0 ? 'l' : 'r';
+    const segs = [
+      { x: 0.16, y: -0.08, z: 1.35, rx: 0.4, len: 0.6 },
+      { x: 0.3, y: -0.45, z: 1.7, rx: 0.95, len: 0.6 },
+      { x: 0.38, y: -0.95, z: 1.88, rx: 1.35, len: 0.55 },
+    ];
+    segs.forEach((s, i) => {
+      const rib = mesh(new THREE.BoxGeometry(radius * 0.13, radius * 0.02, radius * s.len), cloth, `ribbon-${tag}-${i}`);
+      rib.position.set(side * radius * s.x, yBand + radius * s.y, radius * s.z);
+      rib.rotation.set(s.rx, side * 0.3, 0);
+      g.add(rib);
+    });
+  }
+  return g;
+}
