+/** Senegalese Laamb: a tied cloth headband hung with gris-gris amulet pouches. */
+export function createLaambBand(radius, colors) {
+  const g = group('headwear-wrestler_laamb');
+  const cloth = primaryMaterial(colors, { roughness: 0.85 });
+  const cord = accentMaterial(colors, { roughness: 0.9 });
+  const leather = fixedMaterial(LEATHER_HEX, { roughness: 0.75 });
+
+  const yBand = radius * 0.30;
+  g.add(ring(radius * 1.05, radius * 0.075, Math.PI * 2, cloth, { y: yBand, name: 'band', tall: 2.1 }));
+
+  // Knot at the back-left with two cloth tails.
+  const k = onSkull(radius * 1.08, Math.PI * 0.82, yBand);
+  const knot = mesh(new THREE.SphereGeometry(radius * 0.15, 14, 10), cloth, 'knot');
+  knot.position.copy(k);
+  g.add(knot);
+  for (const [dx, dy, dz, tag] of [[0.12, -0.42, 0.22, 'a'], [-0.08, -0.5, 0.3, 'b']]) {
+    const tail = mesh(new THREE.BoxGeometry(radius * 0.11, radius * 0.02, radius * 0.5), cloth, `tail-${tag}`);
+    tail.position.set(k.x + radius * dx, k.y + radius * dy, k.z + radius * dz);
+    tail.rotation.set(1.1, dx * 2, 0);
+    g.add(tail);
+  }
+
+  // Gris-gris: leather pouches on cords at the brow and both temples.
+  for (const a of [-0.55, 0, 0.55]) {
+    const top = onSkull(radius * 1.05, a, yBand - radius * 0.06);
+    const bottom = onSkull(radius * 1.08, a, yBand - radius * 0.34);
+    g.add(strut(top, bottom, radius * 0.018, cord, `cord-${a}`));
+    const pouch = mesh(new THREE.BoxGeometry(radius * 0.17, radius * 0.2, radius * 0.08), leather, `pouch-${a}`);
+    pouch.position.copy(bottom);
+    pouch.position.y -= radius * 0.1;
+    pouch.rotation.y = a;
+    g.add(pouch);
+  }
+  return g;
+}
