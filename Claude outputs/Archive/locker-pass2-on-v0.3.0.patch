+
+function horn(radius, material, side, height, baseR, name) {
+  const spike = mesh(new THREE.ConeGeometry(baseR, height, 14), material, name);
+  spike.position.set(side * radius * 0.84, radius * 0.72 + height * 0.42, -radius * 0.12);
+  spike.rotation.set(-0.22, 0, side * -0.66);
+  return spike;
+}
