+// ---------------------------------------------------------------------------
+// BLACK: Sensor VISOR
+// ---------------------------------------------------------------------------
+
+/**
+ * A temple-to-temple curved VISOR in the La Forge tradition: a flat metallic
+ * band with ribbed emissive slits, clipped at the temples.
+ */
+export function createSensorVisor(radius, colors) {
+  const g = group('headwear-sensor_visor');
+  const housing = accentMaterial(colors, { roughness: 0.4, metalness: 0.55 });
+  const glow = visorMaterial(colors);
+
+  const yEye = radius * 0.10;
+  const R = radius * 1.10;
+
+  // The band: wide, flat, wrapping past the temples.
+  g.add(ring(R, radius * 0.16, Math.PI * 1.08, housing, { y: yEye, name: 'band', tall: 0.72 }));
+
+  // Ribbed emissive slits across the front.
+  for (const dy of [-0.055, 0, 0.055]) {
+    g.add(ring(R + radius * 0.165, radius * 0.024, Math.PI * 0.98, glow, { y: yEye + radius * dy, name: `slit-${dy}` }));
+  }
+
+  // Temple clips: blocky anchors with an emissive status dot.
+  for (const side of [-1, 1]) {
+    const tag = side < 0 ? 'l' : 'r';
+    const clip = mesh(new THREE.BoxGeometry(radius * 0.16, radius * 0.26, radius * 0.34), housing, `clip-${tag}`);
+    clip.position.set(side * radius * 1.12, yEye, radius * 0.12);
+    clip.rotation.y = side * 0.28;
+    g.add(clip);
+    const dot = mesh(new THREE.SphereGeometry(radius * 0.05, 10, 8), glow, `dot-${tag}`);
+    dot.position.set(side * radius * 1.21, yEye + radius * 0.08, radius * 0.05);
+    g.add(dot);
+    // Arm back over the ear to the skull.
+    g.add(strut(new THREE.Vector3(side * radius * 1.1, yEye, radius * 0.28), new THREE.Vector3(side * radius * 0.95, yEye + radius * 0.05, radius * 0.72), radius * 0.035, housing, `arm-${tag}`));
+  }
+  return g;
+}
